# PerformX Environment Variables
# Copy this file to .env.local and fill in your values

# Form submission webhook (Make, Zapier, n8n, or custom endpoint)
FORM_ENDPOINT_URL=

# Google Analytics 4 Measurement ID
NEXT_PUBLIC_GA4_ID=

# Booking calendar URL (Calendly, Cal.com, HubSpot Meetings)
NEXT_PUBLIC_BOOKING_URL=

# CRM API key (HubSpot, Pipedrive, GoHighLevel)
CRM_API_KEY=
CRM_PROVIDER=

# Email service (Klaviyo, Mailchimp)
EMAIL_API_KEY=

# WhatsApp Business number (for floating button)
NEXT_PUBLIC_WA_NUMBER=918839685579
